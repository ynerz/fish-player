# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 依赖 / 构建（本项目零依赖，仅作预防）----
node_modules/
dist/
build/
*.log

# ---- 本地工具产物 ----
.playwright-cli/
tools/output/
*.tmp

# ---- 助手本地工作区（存档记忆等，不入库）----
.workbuddy/

# AI 生成的美术素材（体积大、可由 tools/ 的脚本复现，不进版本库）
# 保留 manifest.json —— 它记录提示词/种子/参数，是「来源可复现」的凭据
assets/cards/*.png
assets/cards/_superseded/

# Python 字节码缓存
__pycache__/
*.pyc
